# FaceGYM backend environment template — PLACEHOLDER VALUES ONLY.
# Copy to .env and provision real secrets at deploy time (never commit them).
# See SECURITY.md §2 for the full secrets contract.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/membership_db
# Read-only RLS role for the member portal (empty disables portal sessions)
MEMBER_PORTAL_DATABASE_URL=postgresql://member_portal:password@localhost:5432/membership_db

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Security (REQUIRED — fail closed when unset) ---------------------------
SECRET_KEY=change-me-min-32-random-chars
ENCRYPTION_KEY=change-me-32-hex-chars
JWT_SECRET=change-me-min-32-random-chars
# Backend side of the relay ↔ backend internal channel (WS-1); empty denies all
PORTAL_INTERNAL_API_KEY=change-me-internal-key

# --- Wompi payments ---------------------------------------------------------
WOMPI_PUBLIC_KEY=pub_test_placeholder
# HMAC-SHA256 webhook verification — unset rejects every webhook (fail closed)
WOMPI_INTEGRITY_SECRET=change-me-integrity-secret

# --- Evolution API (WhatsApp member auth) -----------------------------------
EVOLUTION_API_URL=https://wappbot.example.com
EVOLUTION_API_KEY=change-me-evolution-key
EVOLUTION_INSTANCE_NAME=SMS-Verification
