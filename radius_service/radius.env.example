# /etc/faceapp/radius.env — environment for the facegym-radius service.
# Install as root with mode 0600 (contains shared secrets):
#   install -m 600 radius.env.example /etc/faceapp/radius.env
#   then edit the values. NEVER commit the real file.

# Shared secret between pfSense and this gateway (RADIUS protocol secret).
# Generate with: openssl rand -hex 24
# Must be >= 16 chars. Enter the SAME value in pfSense's RADIUS server config.
RADIUS_SHARED_SECRET=change-me-openssl-rand-hex-24

# Same INTERNAL_API_SECRET the backend uses (backend/.env). The gateway
# authenticates to POST /api/wifi/authorize|accounting with it.
INTERNAL_API_SECRET=change-me-same-as-backend

# Backend base URL (internal — the gateway never leaves the host/LAN).
RADIUS_BACKEND_API_URL=http://localhost:8000/api

# Bind (UDP). 0.0.0.0 exposes to every interface: restrict UDP 1812/1813 to
# the pfSense IP in the host firewall (runbook §4).
RADIUS_LISTEN_HOST=0.0.0.0
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813

# Optional tuning
RADIUS_BACKEND_TIMEOUT_SECONDS=5
RADIUS_FAIL_THRESHOLD=5
RADIUS_FAIL_COOLDOWN_SECONDS=60
LOG_LEVEL=INFO
