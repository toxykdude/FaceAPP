[Unit]
Description=PowerHouse Membership Backup (pg_dump + biometric + remote replication)
Documentation=file:///opt/powerhouse-membership/scripts/backup.sh
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
# .env provides DATABASE_URL + BACKUP_REMOTE_* / SMB_* / RSYNC_* credentials.
EnvironmentFile=/opt/powerhouse-membership/.env
# BACKUP_DATABASE_URL: the dedicated BYPASSRLS role pg_dump must connect as on
# an RLS-enforced database (scripts/migrations/003_backup_role.sql). Listed
# AFTER .env so it wins, and optional ('-') so a host without the backup role
# still runs — backup.sh then falls back to DATABASE_URL and its dump
# verification fails loudly rather than shipping a truncated archive.
EnvironmentFile=-/etc/faceapp/backup-db.env
ExecStart=/opt/powerhouse-membership/scripts/backup.sh
# Backup failures must surface to the journal for the operator; the timer
# remains armed for the next run regardless of the last exit code.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
