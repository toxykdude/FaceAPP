# ===========================================
# FaceGYM — Environment Configuration
# ===========================================
# Copy this file to backend/.env and fill in the values.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"

# Database
DATABASE_URL=postgresql://membership:YOUR_PASSWORD@localhost:5432/membership_db
REDIS_URL=redis://localhost:6379/0

# Security (generate with openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-64-char-string
# AES-256 key for biometric data. Must decode to exactly 32 bytes:
# 44-char base64 (as here), 64-char hex, or raw 32 bytes.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=ZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGQ=
# Refuse to run with cleartext biometric cache / http:// backend transport
REQUIRE_PROD_SECRETS=false
JWT_SECRET=change-me-to-a-random-64-char-string

# Internal service authentication (shared between backend + CV service)
# Generate with: openssl rand -hex 32
# MUST be identical in both backend/.env and cv_service/.env
INTERNAL_API_SECRET=change-me-to-a-random-64-char-string

# CV Service API key (for external access to CV service endpoints)
# Generate with: openssl rand -hex 32
API_KEY=change-me-to-a-random-64-char-string

# Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# Facial Recognition
FACE_CONFIDENCE_THRESHOLD=0.85
ENROLLMENT_QUALITY_THRESHOLD=0.90
MIN_FACE_SIZE=80
MAX_FACES_PER_ENROLLMENT=5

# Application
APP_NAME=FaceGYM
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost

# Frontend Configuration
FRONTEND_URL=http://localhost

# File Storage
UPLOAD_DIR=/var/lib/powerhouse/uploads
BIOMETRIC_STORAGE=/var/lib/powerhouse/biometric_data
MAX_UPLOAD_SIZE=10485760

# Session Configuration
SESSION_TIMEOUT=3600
REFRESH_TOKEN_EXPIRE=604800

# GPU Acceleration
USE_GPU=false
CUDA_DEVICE=0

# Paths
DATA_DIR=/var/lib/powerhouse
BIOMETRIC_DATA_DIR=/var/lib/powerhouse/biometric_data
LOG_DIR=/var/lib/powerhouse/logs

# SMTP Email Configuration (optional — for automated reports)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_USE_SSL=false

# ===========================================
# Scheduled Backup + Remote Replication (optional)
# ===========================================
# The systemd timer (scripts/systemd/powerhouse-backup.timer) runs
# scripts/backup.sh every 30 minutes. Backups always land locally under
# BACKUP_DIR with 30-day retention; remote replication is opt-in below.
#
# Two configuration paths:
#   1. PRIMARY — admin UI: Settings -> Backup tab (admin only). Saves into the
#      database (password encrypted at rest) and atomically rewrites
#      /etc/faceapp/backup-remote.env (mode 0600, root:root).
#   2. FALLBACK — this .env file (manual). Used when the managed file is
#      absent or no DB row exists.
# PRECEDENCE: backup.sh sources .env FIRST, then sources
# /etc/faceapp/backup-remote.env, so DB-managed values (UI) WIN over anything
# set here. Edit this file only for headless/pre-UI deployments, or to force
# fallback by deleting the managed file.
# ALL remote credentials are read at runtime only — they are NEVER stored in
# source control, logs, or ps output.
#
# Install dependencies (added automatically by install.sh on fresh LXC):
#   samba-client -> provides `smbclient` for the SMB transport
#   sshpass      -> required for the SFTP transport (sshpass -e sftp -b)

# Transport for remote replication: none | rsync | sftp | ftp | smb | nfs
# none  -> local backup only (default)
# rsync -> push via rsync/ssh (preferred). Auth via SSH key or RSYNC_PASSWORD.
# sftp  -> push via sshpass -e sftp -b. Requires the `sshpass` package.
# ftp   -> push via curl --netrc-file (0600). WARNING: FTP is cleartext on the
#          wire — prefer SFTP or rsync. Use FTP only on trusted networks.
# smb   -> push via smbclient (SMB3). Requires the `samba-client` package.
# nfs   -> copy into a pre-mounted NFS directory (NFS_MOUNT)
BACKUP_REMOTE_TYPE=none

# rsync target. Either set the parts below, or a single BACKUP_REMOTE_TARGET.
# Example target: bkp@nas.local:/srv/powerhouse-backups
# BACKUP_REMOTE_TARGET=user@host:/path
RSYNC_USER=
RSYNC_HOST=
RSYNC_PATH=

# SFTP target (sshpass -e sftp -b). SSHPASS is read from the ENVIRONMENT ONLY —
# never put it on a command line or in the batch file. Requires `sshpass`.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PATH=
SSHPASS=

# FTP target (curl --netrc-file, mode 0600). WARNING: FTP credentials and data
# travel in CLEARTEXT — prefer SFTP or rsync. Use FTP only on trusted networks.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=

# SMB target (smbclient). SMB_SHARE may be overridden by BACKUP_REMOTE_TARGET.
# Requires the `samba-client` package.
SMB_SHARE=
SMB_USER=
SMB_PASS=
SMB_PATH=backups

# NFS target: a directory that is ALREADY mounted via /etc/fstab.
NFS_MOUNT=

# Local backup layout (override only for non-standard installs).
# BACKUP_DIR=/var/backups/powerhouse
# DATA_DIR=/var/lib/powerhouse
# LOG_FILE=/var/log/powerhouse-backup.log
# RETENTION_DAYS=30

# Optional dedicated backup role for pg_dump (recommended when the app DB
# enforces Row-Level Security: the runtime role cannot pg_dump past RLS, so
# point this at a dedicated role created WITH BYPASSRLS, e.g. powerhouse_backup).
# When set, BOTH the admin /api/system/db-export endpoint and scripts/backup.sh
# prefer it over DATABASE_URL. It is read from the environment at runtime and
# is NEVER logged. Leave unset to keep using DATABASE_URL.
# BACKUP_DATABASE_URL=postgresql://powerhouse_backup:YOUR_PASSWORD@localhost:5432/membership_db
